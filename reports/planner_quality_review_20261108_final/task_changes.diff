+def _contains_label(text: str, label: str) -> bool:
+    """Match an explicit label, ignoring case/punctuation, without guessing synonyms."""
+    words = tuple(re.findall(r"\w+", text.casefold()))
+    reference = tuple(re.findall(r"\w+", label.casefold()))
+    return bool(reference) and any(
+        words[start:start + len(reference)] == reference
+        for start in range(len(words) - len(reference) + 1)
+    )
+
+
+def edit_consistency_issues(request: PlanningInput, result: PlanningResult) -> tuple[str, ...]:
+    """Surface-reference checks, not a claim to understand arbitrary image semantics."""
+    issues: list[str] = []
+    verified = {item.object_id: item.description for item in request.verified_objects}
+    source_text = "\n".join((request.source_caption, *verified.values()))
+    for edit in result.candidate_edits:
+        supported = (edit.verified_object_id is not None
+                     and verified.get(edit.verified_object_id) == edit.object_description)
+        if edit.identity_uncertain or not supported:
+            issues.append(f"Verify the source-object identity of: {edit.object_description}.")
+        if not _contains_label(edit.localization_phrase, edit.object_description):
+            issues.append(f"Localization must retain the original object label: {edit.object_description}.")
+        # A replacement phrase appearing as an original fact is detectable only
+        # when the actual wording matches. Other paraphrases need human checking.
+        if (not _contains_label(source_text, edit.proposed_change)
+                and _contains_label(result.scene_summary, edit.proposed_change)):
+            issues.append("Scene summary contains an intended-change phrase absent from source evidence; verify the original scene.")
+        if any(_contains_label(item, edit.object_description) for item in result.must_preserve):
+            issues.append(f"Potential preserve/edit conflict involving: {edit.object_description}; distinguish unchanged features from object identity.")
+        if any(_contains_label(item, edit.proposed_change) for item in result.must_preserve):
+            issues.append("A preservation statement names the intended change; verify that preservation refers to the original scene.")
+    return tuple(dict.fromkeys(issues))
+
